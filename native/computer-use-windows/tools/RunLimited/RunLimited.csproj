<Project Sdk="Microsoft.NET.Sdk">
  <!-- CI-only launcher: runs a program de-elevated (restricted token, Medium
       integrity) so the helper's smoke test can run on a hosted runner whose
       session is an elevated administrator. Never shipped; the helper does
       not reference it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
</Project>
