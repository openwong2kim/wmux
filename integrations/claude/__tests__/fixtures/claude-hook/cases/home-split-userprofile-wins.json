{
  "description": "USERPROFILE wins over HOME for the tokens, the log and the spool; the other home holds decoy tokens.",
  "homes": {
    "USERPROFILE": "data",
    "HOME": "alt"
  },
  "env": {
    "WMUX_PTY_ID": "pty-1"
  },
  "endpoints": {
    "daemon": {
      "mode": "reply",
      "lines": [
        {
          "id": "$ID",
          "ok": true,
          "result": {
            "ok": false,
            "reason": "no-workspace-match"
          }
        }
      ]
    }
  },
  "steps": [
    {
      "argv": [
        "Stop"
      ],
      "stdin": "{\"session_id\":\"s1\",\"cwd\":\"/work/repo\"}"
    }
  ],
  "expect": {
    "steps": [
      {
        "exitCode": 0,
        "stdout": "",
        "stderr": "",
        "log": [
          {
            "bridge": "0.8.1",
            "hook": "Stop",
            "outcome": "rpc-rejected",
            "target": "daemon",
            "reason": "no-workspace-match"
          },
          {
            "bridge": "0.8.1",
            "hook": "Stop",
            "outcome": "resume-spooled",
            "ptyId": "pty-1",
            "sessionId": "s1"
          }
        ],
        "requests": {
          "daemon": [
            {
              "id": "<request-id>",
              "method": "daemon.hooks.signal",
              "params": {
                "kind": "agent.stop",
                "agent": "claude",
                "agentSessionId": "s1",
                "ptyId": "pty-1",
                "cwd": "/work/repo",
                "payload": {
                  "session_id": "s1",
                  "cwd": "/work/repo"
                },
                "ts": "<ts>"
              },
              "token": "daemon-token",
              "clientName": "wmux-hook-bridge"
            }
          ]
        },
        "spool": {
          "pty-1.json": {
            "ptyId": "pty-1",
            "agent": "claude",
            "sessionId": "s1",
            "cwd": "/work/repo",
            "ts": "<ts>"
          }
        },
        "alt": [
          ".wmux<sfx>/daemon-auth-token",
          ".wmux<sfx>-auth-token"
        ]
      }
    ]
  }
}
