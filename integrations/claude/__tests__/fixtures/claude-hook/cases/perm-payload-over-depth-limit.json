{
  "description": "--permission-gate with a payload one level past the depth limit.",
  "divergence": "Past the depth limit the port sends nothing (logged uncaught, exit 0): the servers' reviver parse fails from about 1 800 levels (a daemon on node 22) or 3 500 (Electron), so a request that deep could never be answered. Node sends it (the stub here parses without a reviver); the port's run has no opinion, so the tool goes through the session's own permission flow.",
  "env": {
    "WMUX_PTY_ID": "pty-1",
    "CLAUDE_CODE_ENTRYPOINT": "cli"
  },
  "endpoints": {
    "daemon": {
      "mode": "reply",
      "lines": [
        {
          "id": "$ID",
          "ok": true,
          "result": {
            "ok": true,
            "permissionDecision": "allow"
          }
        }
      ]
    }
  },
  "variants": {
    "steps.0": [
      {
        "exitCode": 0,
        "stdout": "{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"allow\"}}\n",
        "stderr": "",
        "log": [
          {
            "bridge": "0.8.1",
            "hook": "PreToolUse",
            "outcome": "ok",
            "target": "daemon"
          },
          {
            "bridge": "0.8.1",
            "hook": "PreToolUse",
            "outcome": "permission-gate",
            "target": "daemon",
            "verdict": "allow"
          }
        ],
        "requests": {
          "daemon": [
            {
              "id": "<request-id>",
              "method": "daemon.hooks.signal",
              "params": {
                "kind": "agent.awaiting_permission",
                "agent": "claude",
                "ptyId": "pty-1",
                "entrypoint": "cli",
                "cwd": "<sandbox>/cwd",
                "payload": {
                  "0": [
                    [
                      [
                        [
                          [
                            [
                              [
                                [
                                  [
                                    [
                                      "<json length=2982 sha256=9a786f2fe8ce4064>"
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                },
                "ts": "<ts>"
              },
              "token": "daemon-token",
              "clientName": "wmux-hook-bridge"
            }
          ]
        }
      }
    ]
  },
  "strictForPort": {
    "steps.0": {
      "exitCode": 0,
      "stdout": "",
      "stderr": "",
      "log": [
        {
          "bridge": "0.8.1",
          "hook": "PreToolUse",
          "outcome": "uncaught",
          "error": "RangeError: Maximum call stack size exceeded"
        }
      ],
      "requests": {}
    }
  },
  "steps": [
    {
      "argv": [
        "PreToolUse",
        "--permission-gate"
      ],
      "stdin": {
        "parts": [
          {
            "repeat": "[",
            "count": 1502
          },
          {
            "repeat": "]",
            "count": 1502
          }
        ]
      }
    }
  ],
  "expect": {
    "steps": [
      "<variant>"
    ]
  }
}
