{
  "description": "Flags are matched anywhere after the event and unknown ones are ignored.",
  "endpoints": {
    "daemon": {
      "mode": "reply",
      "lines": [
        {
          "id": "$ID",
          "ok": true,
          "result": {
            "ok": true
          }
        }
      ]
    },
    "main": {
      "mode": "reply",
      "lines": [
        {
          "id": "$ID",
          "ok": true,
          "result": {
            "ok": true,
            "block": {
              "reason": "keep going"
            }
          }
        }
      ]
    }
  },
  "steps": [
    {
      "argv": [
        "Stop",
        "--unknown",
        "--gate"
      ],
      "stdin": "{\"session_id\":\"s1\",\"cwd\":\"/work/repo\"}"
    }
  ],
  "expect": {
    "steps": [
      {
        "exitCode": 2,
        "stdout": "",
        "stderr": "keep going\n",
        "log": [
          {
            "bridge": "0.8.1",
            "hook": "Stop",
            "outcome": "ok",
            "target": "main"
          },
          {
            "bridge": "0.8.1",
            "hook": "Stop",
            "outcome": "gate-blocked",
            "target": "main"
          }
        ],
        "requests": {
          "main": [
            {
              "id": "<request-id>",
              "method": "hooks.signal",
              "params": {
                "kind": "agent.stop",
                "agent": "claude",
                "agentSessionId": "s1",
                "cwd": "/work/repo",
                "payload": {
                  "session_id": "s1",
                  "cwd": "/work/repo"
                },
                "ts": "<ts>"
              },
              "token": "main-token",
              "clientName": "wmux-hook-bridge"
            }
          ]
        }
      }
    ]
  }
}
