{
  "description": "A delegate worker does not report AskUserQuestion.",
  "env": {
    "WMUX_MOA_DELEGATE_WORKER": "1"
  },
  "endpoints": {
    "daemon": {
      "mode": "reply",
      "lines": [
        {
          "id": "$ID",
          "ok": true,
          "result": {
            "ok": true
          }
        }
      ]
    }
  },
  "steps": [
    {
      "argv": [
        "PreToolUse"
      ],
      "stdin": "{\"session_id\":\"s1\",\"tool_name\":\"AskUserQuestion\"}"
