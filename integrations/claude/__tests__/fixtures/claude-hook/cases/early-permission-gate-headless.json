{
  "description": "A non-interactive entrypoint skips the permission gate before stdin.",
  "env": {
    "WMUX_PTY_ID": "pty-1",
    "CLAUDE_CODE_ENTRYPOINT": "sdk-cli"
  },
  "endpoints": {
    "daemon": {
      "mode": "reply",
      "lines": [
        {
          "id": "$ID",
          "ok": true,
          "result": {
            "ok": true
          }
        }
      ]
    }
  },
  "steps": [
    {
      "argv": [
        "PreToolUse",
        "--permission-gate"
      ],
      "stdin": {
        "hold": true
      }
    }
  ],
  "expect": {
    "steps": [
      {
        "exitCode": 0,
        "stdout": "",
        "stderr": "",
        "log": [
          {
            "bridge": "0.8.1",
            "hook": "PreToolUse",
            "outcome": "permission-gate-skipped",
            "reason": "headless-or-outside-wmux",
            "entrypoint": "sdk-cli"
          }
        ],
        "requests": {}
      }
    ]
  }
}
