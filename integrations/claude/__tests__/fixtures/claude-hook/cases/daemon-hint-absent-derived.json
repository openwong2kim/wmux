{
  "description": "Without a hint file the daemon pipe name is derived from the suffix (and user on Windows).",
  "daemonHint": "absent",
  "endpoints": {
    "daemon": {
      "mode": "reply",
      "lines": [
        {
          "id": "$ID",
          "ok": true,
          "result": {
            "ok": true
          }
        }
      ]
    }
  },
  "steps": [
    {
      "argv": [
        "Stop"
      ],
      "stdin": "{\"session_id\":\"s1\",\"cwd\":\"/work/repo\"}"
    }
  ],
  "expect": {
    "steps": [
      {
        "exitCode": 0,
        "stdout": "",
        "stderr": "",
        "log": [
          {
            "bridge": "0.8.1",
            "hook": "Stop",
            "outcome": "ok",
            "target": "daemon"
          }
        ],
        "requests": {
          "daemon": [
            {
              "id": "<request-id>",
              "method": "daemon.hooks.signal",
              "params": {
                "kind": "agent.stop",
                "agent": "claude",
                "agentSessionId": "s1",
                "cwd": "/work/repo",
                "payload": {
                  "session_id": "s1",
                  "cwd": "/work/repo"
                },
                "ts": "<ts>"
              },
              "token": "daemon-token",
              "clientName": "wmux-hook-bridge"
            }
          ]
        }
      }
    ]
  }
}
