{
  "description": "A reply that arrives before the server has read the whole request still counts.",
  "endpoints": {
    "daemon": {
      "mode": "reply-early",
      "lines": [
        {
          "id": "$ID",
          "ok": true,
          "result": {
            "ok": true
          }
        }
      ]
    },
    "main": {
      "mode": "reply",
      "lines": [
        {
          "id": "$ID",
          "ok": true,
          "result": {
            "ok": true
          }
        }
      ]
    }
  },
  "steps": [
    {
      "argv": [
        "Stop"
      ],
      "stdin": {
        "parts": [
          "{\"session_id\":\"s1\",\"cwd\":\"/work/repo\",\"blob\":\"",
          {
            "repeat": "a",
            "count": 900000
          },
          "\"}"
        ]
      }
    }
  ],
  "expect": {
    "steps": [
      {
        "exitCode": 0,
        "stdout": "",
        "stderr": "",
        "log": [
          {
            "bridge": "0.8.1",
            "hook": "Stop",
            "outcome": "ok",
            "target": "daemon"
          }
        ],
        "requests": {
          "daemon": [
            {
              "answeredEarly": true,
              "sawNewline": false
            }
          ]
        }
      }
    ]
  }
}
