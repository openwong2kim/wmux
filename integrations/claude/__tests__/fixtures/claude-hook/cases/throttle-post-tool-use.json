{
  "description": "PostToolUse stamps the pane; a stamp 500 ms old silences the next one, a stamp 5 s old does not. Stamp ages are set, not waited for.",
  "env": {
    "WMUX_PTY_ID": "pty-1"
  },
  "endpoints": {
    "daemon": {
      "mode": "reply",
      "lines": [
        {
          "id": "$ID",
          "ok": true,
          "result": {
            "ok": true
          }
        }
      ]
    }
  },
  "steps": [
    {
      "argv": [
        "PostToolUse"
      ],
      "stdin": "{\"session_id\":\"s1\",\"tool_name\":\"Read\"}"
    },
    {
      "argv": [
        "PostToolUse"
      ],
      "stdin": "{\"session_id\":\"s1\",\"tool_name\":\"Read\"}",
      "stampAges": {
        "pty-1": 500
      }
    },
    {
      "argv": [
        "PostToolUse"
      ],
      "stdin": "{\"session_id\":\"s1\",\"tool_name\":\"Read\"}",
      "stampAges": {
        "pty-1": 5000
      }
    }
  ],
  "expect": {
    "steps": [
      {
        "exitCode": 0,
        "stdout": "",
        "stderr": "",
        "log": [
          {
            "bridge": "0.8.1",
            "hook": "PostToolUse",
            "outcome": "ok",
            "target": "daemon"
          }
        ],
        "requests": {
          "daemon": [
            {
              "id": "<request-id>",
              "method": "daemon.hooks.signal",
              "params": {
                "kind": "agent.activity",
                "agent": "claude",
                "agentSessionId": "s1",
                "ptyId": "pty-1",
                "cwd": "<sandbox>/cwd",
                "payload": {
                  "session_id": "s1",
                  "tool_name": "Read"
                },
                "ts": "<ts>"
              },
              "token": "daemon-token",
              "clientName": "wmux-hook-bridge"
            }
          ]
        },
        "stamps": [
          "pty-1"
        ]
      },
      {
        "exitCode": 0,
        "stdout": "",
        "stderr": "",
        "log": [],
        "requests": {},
        "stamps": [
          "pty-1"
        ]
      },
      {
        "exitCode": 0,
        "stdout": "",
        "stderr": "",
        "log": [
          {
            "bridge": "0.8.1",
            "hook": "PostToolUse",
            "outcome": "ok",
            "target": "daemon"
          }
        ],
        "requests": {
          "daemon": [
            {
              "id": "<request-id>",
              "method": "daemon.hooks.signal",
              "params": {
                "kind": "agent.activity",
                "agent": "claude",
                "agentSessionId": "s1",
                "ptyId": "pty-1",
                "cwd": "<sandbox>/cwd",
                "payload": {
                  "session_id": "s1",
                  "tool_name": "Read"
                },
                "ts": "<ts>"
              },
              "token": "daemon-token",
              "clientName": "wmux-hook-bridge"
            }
          ]
        },
        "stamps": [
          "pty-1"
        ]
      }
    ]
  }
}
