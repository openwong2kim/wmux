{
  "description": "A deny that arrives before the whole request was read is still written.",
  "env": {
    "WMUX_PTY_ID": "pty-1",
    "CLAUDE_CODE_ENTRYPOINT": "cli"
  },
  "endpoints": {
    "daemon": {
      "mode": "reply-early",
      "lines": [
        {
          "id": "$ID",
          "ok": true,
          "result": {
            "ok": true,
            "permissionDecision": "deny"
          }
        }
      ]
    }
  },
  "steps": [
    {
      "argv": [
        "PreToolUse",
        "--permission-gate"
      ],
      "stdin": {
        "parts": [
          "{\"session_id\":\"s1\",\"tool_name\":\"Write\",\"tool_input\":{\"content\":\"",
          {
            "repeat": "z",
            "count": 900000
          },
          "\"}}"
        ]
      }
    }
  ],
  "expect": {
    "steps": [
      {
        "exitCode": 0,
        "stdout": "{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"denied from the wmux remote approval\"}}\n",
        "stderr": "",
        "log": [
          {
            "bridge": "0.8.1",
            "hook": "PreToolUse",
            "outcome": "ok",
            "target": "daemon"
          },
          {
            "bridge": "0.8.1",
            "hook": "PreToolUse",
            "outcome": "permission-gate",
            "target": "daemon",
            "verdict": "deny"
          }
        ],
        "requests": {
          "daemon": [
            {
              "answeredEarly": true,
              "sawNewline": false
            }
          ]
        }
      }
    ]
  }
}
