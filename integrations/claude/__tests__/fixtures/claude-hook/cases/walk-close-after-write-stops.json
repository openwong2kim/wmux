{
  "description": "Closed after the request was read: no fallback, and the pane is spooled.",
  "env": {
    "WMUX_PTY_ID": "pty-1"
  },
  "endpoints": {
    "daemon": {
      "mode": "close-after-read"
    },
    "main": {
      "mode": "reply",
      "lines": [
        {
          "id": "$ID",
          "ok": true,
          "result": {
            "ok": true
          }
        }
      ]
    }
  },
  "steps": [
    {
      "argv": [
        "Stop"
      ],
      "stdin": "{\"session_id\":\"s1\",\"cwd\":\"/work/repo\"}"
    }
  ],
  "expect": {
    "steps": [
      {
        "exitCode": 0,
        "stdout": "",
        "stderr": "",
        "log": [
          {
            "bridge": "0.8.1",
            "hook": "Stop",
            "outcome": "rpc-failed",
            "target": "daemon",
            "error": "closed-without-response"
          },
          {
            "bridge": "0.8.1",
            "hook": "Stop",
            "outcome": "resume-spooled",
            "ptyId": "pty-1",
            "sessionId": "s1"
          }
        ],
        "requests": {
          "daemon": [
            {
              "id": "<request-id>",
              "method": "daemon.hooks.signal",
              "params": {
                "kind": "agent.stop",
                "agent": "claude",
                "agentSessionId": "s1",
                "ptyId": "pty-1",
                "cwd": "/work/repo",
                "payload": {
                  "session_id": "s1",
                  "cwd": "/work/repo"
                },
                "ts": "<ts>"
              },
              "token": "daemon-token",
              "clientName": "wmux-hook-bridge"
            }
          ]
        },
        "spool": {
          "pty-1.json": {
            "ptyId": "pty-1",
            "agent": "claude",
            "sessionId": "s1",
            "cwd": "/work/repo",
            "ts": "<ts>"
          }
        }
      }
    ]
  }
}
