{
  "description": "The plain-object lookup lets an inherited key through; the envelope then has no kind.",
  "divergence": "native accepts only the hook names in HOOK_TO_KIND: an inherited key is unknown-hook-name and nothing is sent",
  "endpoints": {
    "daemon": {
      "mode": "reply",
      "lines": [
        {
          "id": "$ID",
          "ok": true,
          "result": {
            "ok": true
          }
        }
      ]
    }
  },
  "variants": {
    "steps.0.log": [
      [
        {
          "bridge": "0.8.1",
          "hook": "constructor",
          "outcome": "ok",
          "target": "daemon"
        }
      ]
    ],
    "steps.0.requests": [
      {
        "daemon": [
          {
            "id": "<request-id>",
            "method": "daemon.hooks.signal",
            "params": {
              "agent": "claude",
              "agentSessionId": "s1",
              "cwd": "/work/repo",
              "payload": {
                "session_id": "s1",
                "cwd": "/work/repo"
              },
              "ts": "<ts>"
            },
            "token": "daemon-token",
            "clientName": "wmux-hook-bridge"
          }
        ]
      }
    ]
  },
  "strictForPort": {
    "steps.0.log": [
      {
        "bridge": "0.8.1",
        "hook": "constructor",
        "outcome": "unknown-hook-name",
        "argv": [
          "<impl>",
          "<prefix>",
          "constructor"
        ]
      }
    ],
    "steps.0.requests": {}
  },
  "steps": [
    {
      "argv": [
        "constructor"
      ],
      "stdin": "{\"session_id\":\"s1\",\"cwd\":\"/work/repo\"}"
    }
  ],
  "expect": {
    "steps": [
      {
        "exitCode": 0,
        "stdout": "",
        "stderr": "",
        "log": "<variant>",
        "requests": "<variant>"
      }
    ]
  }
}
