{
  "description": "SessionEnd goes to the daemon alone, so a missing daemon is not followed by main.",
  "endpoints": {
    "main": {
      "mode": "reply",
      "lines": [
        {
          "id": "$ID",
          "ok": true,
          "result": {
            "ok": true
          }
        }
      ]
    }
  },
  "steps": [
    {
      "argv": [
        "SessionEnd"
      ],
      "stdin": "{\"session_id\":\"s1\",\"cwd\":\"/work/repo\"}"
    }
  ],
  "expect": {
    "steps": [
      {
        "exitCode": 0,
        "stdout": "",
        "stderr": "",
        "log": [
          {
            "bridge": "0.8.1",
            "hook": "SessionEnd",
            "outcome": "rpc-failed",
            "target": "daemon",
            "error": "connect-error",
            "detail": "ENOENT"
          }
        ],
        "requests": {}
      }
    ]
  }
}
