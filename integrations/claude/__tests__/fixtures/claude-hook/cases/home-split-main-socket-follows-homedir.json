{
  "description": "The main pipe is derived from os.homedir() (HOME on POSIX), while its token follows USERPROFILE.",
  "homes": {
    "USERPROFILE": "data",
    "HOME": "alt"
  },
  "env": {
    "WMUX_HOOKS_TO_MAIN": "1"
  },
  "endpoints": {
    "main": {
      "mode": "reply",
      "lines": [
        {
          "id": "$ID",
          "ok": true,
          "result": {
            "ok": true
          }
        }
      ]
    }
  },
  "steps": [
    {
      "argv": [
        "Stop"
      ],
      "stdin": "{\"session_id\":\"s1\",\"cwd\":\"/work/repo\"}"
    }
  ],
  "expect": {
    "steps": [
      {
        "exitCode": 0,
        "stdout": "",
        "stderr": "",
        "log": [
          {
            "bridge": "0.8.1",
            "hook": "Stop",
            "outcome": "ok",
            "target": "main"
          }
        ],
        "requests": {
          "main": [
            {
              "id": "<request-id>",
              "method": "hooks.signal",
              "params": {
                "kind": "agent.stop",
                "agent": "claude",
                "agentSessionId": "s1",
                "cwd": "/work/repo",
                "payload": {
                  "session_id": "s1",
                  "cwd": "/work/repo"
                },
                "ts": "<ts>"
              },
              "token": "main-token",
              "clientName": "wmux-hook-bridge"
            }
          ]
        },
        "alt": [
          ".wmux<sfx>/daemon-auth-token",
          ".wmux<sfx>-auth-token"
        ]
      }
    ]
  }
}
