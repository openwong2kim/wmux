{
  "description": "A reply followed at once by a close, before the server read the whole request: the bridge may settle on the reply or on the socket error.",
  "endpoints": {
    "daemon": {
      "mode": "reply-early-close",
      "lines": [
        {
          "id": "$ID",
          "ok": true,
          "result": {
            "ok": true
          }
        }
      ]
    },
    "main": {
      "mode": "reply",
      "lines": [
        {
          "id": "$ID",
          "ok": true,
          "result": {
            "ok": true
          }
        }
      ]
    }
  },
  "variants": {
    "steps.0.log.0": [
      {
        "bridge": "0.8.1",
        "hook": "Stop",
        "outcome": "ok",
        "target": "daemon"
      },
      {
        "bridge": "0.8.1",
        "hook": "Stop",
        "outcome": "rpc-failed",
        "target": "daemon",
        "error": "closed-without-response"
      },
      {
        "bridge": "0.8.1",
        "hook": "Stop",
        "outcome": "rpc-failed",
        "target": "daemon",
        "error": "connect-error",
        "detail": "EPIPE"
      },
      {
        "bridge": "0.8.1",
        "hook": "Stop",
        "outcome": "rpc-failed",
        "target": "daemon",
        "error": "connect-error",
        "detail": "ECONNRESET"
      },
      {
        "bridge": "0.8.1",
        "hook": "Stop",
        "outcome": "rpc-failed",
        "target": "daemon",
        "error": "connect-error",
        "detail": "ENOTCONN"
      },
      {
        "bridge": "0.8.1",
        "hook": "Stop",
        "outcome": "rpc-failed",
        "target": "daemon",
        "error": "connect-error",
        "detail": "ECONNABORTED"
      }
    ]
  },
  "steps": [
    {
      "argv": [
        "Stop"
      ],
      "stdin": {
        "parts": [
          "{\"session_id\":\"s1\",\"cwd\":\"/work/repo\",\"blob\":\"",
          {
            "repeat": "a",
            "count": 900000
          },
          "\"}"
        ]
      }
    }
  ],
  "expect": {
    "steps": [
      {
        "exitCode": 0,
        "stdout": "",
        "stderr": "",
        "log": [
          "<variant>"
        ],
        "requests": {
          "daemon": [
            {
              "answeredEarly": true,
              "sawNewline": false
            }
          ]
        }
      }
    ]
  }
}
