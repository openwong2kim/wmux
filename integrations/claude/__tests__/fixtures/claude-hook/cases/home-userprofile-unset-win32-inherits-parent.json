{
  "description": "On Windows a child env without USERPROFILE gets the parent's (uv_spawn required_vars), so the bridge reads that home, not HOME. The parent's USERPROFILE is pointed at the sandbox's alt home for the run: decoy tokens, its log there, nothing outside the sandbox. Recorded by hand from that rule; no Windows host recorded it.",
  "platforms": [
    "win32"
  ],
  "skipReason": "POSIX children start with exactly the env they are given",
  "homes": {
    "USERPROFILE": "unset",
    "HOME": "data",
    "parentUSERPROFILE": "alt"
  },
  "endpoints": {
    "daemon": {
      "mode": "reply",
      "lines": [
        {
          "id": "$ID",
          "ok": true,
          "result": {
            "ok": true
          }
        }
      ]
    },
    "main": {
      "mode": "reply",
      "lines": [
        {
          "id": "$ID",
          "ok": true,
          "result": {
            "ok": true
          }
        }
      ]
    }
  },
  "steps": [
    {
      "argv": [
        "Stop"
      ],
      "stdin": "{\"session_id\":\"s1\",\"cwd\":\"/work/repo\"}"
    }
  ],
  "expect": {
    "steps": [
      {
        "exitCode": 0,
        "stdout": "",
        "stderr": "",
        "log": [],
        "requests": {
          "main": [
            {
              "id": "<request-id>",
              "method": "hooks.signal",
              "params": {
                "kind": "agent.stop",
                "agent": "claude",
                "agentSessionId": "s1",
                "cwd": "/work/repo",
                "payload": {
                  "session_id": "s1",
                  "cwd": "/work/repo"
                },
                "ts": "<ts>"
              },
              "token": "decoy-main-token",
              "clientName": "wmux-hook-bridge"
            }
          ]
        },
        "alt": [
          ".wmux<sfx>/bridge.log",
          ".wmux<sfx>/daemon-auth-token",
          ".wmux<sfx>-auth-token"
        ],
        "altLog": [
          {
            "bridge": "0.8.1",
            "hook": "Stop",
            "outcome": "ok",
            "target": "main"
          }
        ]
      }
    ]
  }
}
