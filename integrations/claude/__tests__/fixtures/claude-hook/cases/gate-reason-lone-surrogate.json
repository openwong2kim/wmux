{
  "description": "Stop --gate with a block reason holding a lone surrogate: written to stderr as UTF-8 with U+FFFD.",
  "endpoints": {
    "main": {
      "mode": "reply",
      "lines": [
        {
          "id": "$ID",
          "ok": true,
          "result": {
            "ok": true,
            "block": {
              "reason": "\ud800 wait"
            }
          }
        }
      ]
    }
  },
  "steps": [
    {
      "argv": [
        "Stop",
        "--gate"
      ],
      "stdin": "{\"session_id\":\"s1\"}"
    }
  ],
  "expect": {
    "steps": [
      {
        "exitCode": 2,
        "stdout": "",
        "stderr": "� wait\n",
        "log": [
          {
            "bridge": "0.8.1",
            "hook": "Stop",
            "outcome": "ok",
            "target": "main"
          },
          {
            "bridge": "0.8.1",
            "hook": "Stop",
            "outcome": "gate-blocked",
            "target": "main"
          }
        ],
        "requests": {
          "main": [
            {
              "id": "<request-id>",
              "method": "hooks.signal",
              "params": {
                "kind": "agent.stop",
                "agent": "claude",
                "agentSessionId": "s1",
                "cwd": "<sandbox>/cwd",
                "payload": {
                  "session_id": "s1"
                },
                "ts": "<ts>"
              },
              "token": "main-token",
              "clientName": "wmux-hook-bridge"
            }
          ]
        }
      }
    ]
  }
}
