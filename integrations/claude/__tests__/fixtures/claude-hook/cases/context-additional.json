{
  "description": "additionalContext is printed as hook output.",
  "endpoints": {
    "daemon": {
      "mode": "reply",
      "lines": [
        {
          "id": "$ID",
          "ok": true,
          "result": {
            "ok": true
          }
        }
      ]
    },
    "main": {
      "mode": "reply",
      "lines": [
        {
          "id": "$ID",
          "ok": true,
          "result": {
            "ok": true,
            "additionalContext": "Fleet: 2 running.\n\"quoted\"   😀"
          }
        }
      ]
    }
  },
  "steps": [
    {
      "argv": [
        "UserPromptSubmit",
        "--context"
      ],
      "stdin": "{\"session_id\":\"s1\",\"prompt\":\"hi\",\"permission_mode\":\"plan\"}"
    }
  ],
  "expect": {
    "steps": [
      {
        "exitCode": 0,
        "stdout": "{\"hookSpecificOutput\":{\"hookEventName\":\"UserPromptSubmit\",\"additionalContext\":\"Fleet: 2 running.\\n\\\"quoted\\\"   😀\"}}\n",
        "stderr": "",
        "log": [
          {
            "bridge": "0.8.1",
            "hook": "UserPromptSubmit",
            "outcome": "ok",
            "target": "main"
          },
          {
            "bridge": "0.8.1",
            "hook": "UserPromptSubmit",
            "outcome": "prompt-context",
            "target": "main"
          }
        ],
        "requests": {
          "main": [
            {
              "id": "<request-id>",
              "method": "hooks.signal",
              "params": {
                "kind": "agent.user_prompt_submit",
                "agent": "claude",
                "agentSessionId": "s1",
                "cwd": "<sandbox>/cwd",
                "payload": {
                  "session_id": "s1",
                  "prompt": "hi",
                  "permission_mode": "plan",
                  "permissionMode": "plan"
                },
                "ts": "<ts>"
              },
              "token": "main-token",
              "clientName": "wmux-hook-bridge"
            }
          ]
        }
      }
    ]
  }
}
