{
  "description": "An event name that is not a hook is logged and exits 0 without reading stdin.",
  "divergence": "native logs its own argv: [<exe>, \"claude-hook\", …]",
  "variants": {
    "steps.0.log.0.argv": [
      [
        "<node>",
        "<bridge>",
        "Bogus"
      ]
    ]
  },
  "strictForPort": {
    "steps.0.log.0.argv": [
      "<impl>",
      "claude-hook",
      "Bogus"
    ]
  },
  "steps": [
    {
      "argv": [
        "Bogus"
      ],
      "stdin": {
        "hold": true
      }
    }
  ],
  "expect": {
    "steps": [
      {
        "exitCode": 0,
        "stdout": "",
        "stderr": "",
        "log": [
          {
            "bridge": "0.8.1",
            "hook": "Bogus",
            "outcome": "unknown-hook-name",
            "argv": "<variant>"
          }
        ],
        "requests": {}
      }
    ]
  }
}
