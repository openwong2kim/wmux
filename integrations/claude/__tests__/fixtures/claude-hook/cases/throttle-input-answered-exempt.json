{
  "description": "A PostToolUse AskUserQuestion is input_answered and never throttled.",
  "env": {
    "WMUX_PTY_ID": "pty-1"
  },
  "endpoints": {
    "daemon": {
      "mode": "reply",
      "lines": [
        {
          "id": "$ID",
          "ok": true,
          "result": {
            "ok": true
          }
        }
      ]
    }
  },
  "steps": [
    {
      "argv": [
        "PostToolUse"
      ],
      "stdin": "{\"session_id\":\"s1\",\"tool_name\":\"AskUserQuestion\"}"
    },
    {
      "argv": [
        "PostToolUse"
      ],
      "stdin": "{\"session_id\":\"s1\",\"tool_name\":\"AskUserQuestion\"}"
    }
  ],
