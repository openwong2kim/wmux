{
  "description": "UserPromptSubmit --context --permission-gate: additionalContext and the permission decision are two stdout lines.",
  "env": {
    "WMUX_PTY_ID": "pty-1",
    "CLAUDE_CODE_ENTRYPOINT": "cli"
  },
  "endpoints": {
    "main": {
      "mode": "reply",
      "lines": [
        {
          "id": "$ID",
          "ok": true,
          "result": {
            "ok": true,
            "additionalContext": "c",
            "permissionDecision": "allow"
          }
        }
      ]
    }
  },
  "steps": [
    {
      "argv": [
        "UserPromptSubmit",
        "--context",
        "--permission-gate"
      ],
      "stdin": "{\"session_id\":\"s1\",\"prompt\":\"p\"}"
    }
  ],
  "expect": {
    "steps": [
      {
        "exitCode": 0,
        "stdout": "{\"hookSpecificOutput\":{\"hookEventName\":\"UserPromptSubmit\",\"additionalContext\":\"c\"}}\n{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"allow\"}}\n",
        "stderr": "",
        "log": [
          {
            "bridge": "0.8.1",
            "hook": "UserPromptSubmit",
            "outcome": "ok",
            "target": "main"
          },
          {
            "bridge": "0.8.1",
            "hook": "UserPromptSubmit",
            "outcome": "prompt-context",
            "target": "main"
          },
          {
            "bridge": "0.8.1",
            "hook": "UserPromptSubmit",
            "outcome": "permission-gate",
            "target": "main",
            "verdict": "allow"
          }
        ],
        "requests": {
          "main": [
            {
              "id": "<request-id>",
              "method": "hooks.signal",
              "params": {
                "kind": "agent.awaiting_permission",
                "agent": "claude",
                "agentSessionId": "s1",
                "ptyId": "pty-1",
                "entrypoint": "cli",
                "cwd": "<sandbox>/cwd",
                "payload": {
                  "session_id": "s1",
                  "prompt": "p"
                },
                "ts": "<ts>"
              },
              "token": "main-token",
              "clientName": "wmux-hook-bridge"
            }
          ]
        }
      }
    ]
  }
}
