{
  "description": "No main pipe fails open.",
  "endpoints": {
    "daemon": {
      "mode": "reply",
      "lines": [
        {
          "id": "$ID",
          "ok": true,
          "result": {
            "ok": true
          }
        }
      ]
    }
  },
  "steps": [
    {
      "argv": [
        "Stop",
        "--gate"
      ],
      "stdin": "{\"session_id\":\"s1\",\"cwd\":\"/work/repo\"}"
    }
  ],
  "expect": {
    "steps": [
      {
        "exitCode": 0,
        "stdout": "",
        "stderr": "",
        "log": [
          {
            "bridge": "0.8.1",
            "hook": "Stop",
            "outcome": "rpc-failed",
            "target": "main",
            "error": "connect-error",
            "detail": "ENOENT"
          }
        ],
        "requests": {}
      }
    ]
  }
}
