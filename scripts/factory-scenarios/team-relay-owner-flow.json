{
  "name": "team-relay-owner-flow",
  "layer": "regression",
  "runs": 1,
  "model": "stub",
  "description": "The owner asks the coordinator by name (an untagged room message would reach it alone too); it dispatches the researcher with the developer and the issue bot to follow (next). The researcher and the developer work through fan-out workers and each sends one result from its task's wake; wmux sends the work on to the next bot in the coordinator's name, and the coordinator is woken once, with the last result, and reports in the flow's thread. One run, depths 0,1,1,2,2,3, one thread, a pointer card in General, the research taint carried to the developer's task.",
  "setup": {
    "repo": true,
    "worker": {
      "delayMs": 1000
    },
    "bots": [
      {
        "key": "lead",
        "template": "coordinator",
        "triggers": [],
        "script": {
          "turns": [
            {
              "steps": [
                {
                  "tool": "handoff_send",
                  "args": {
                    "kind": "dispatch",
                    "to_bot_id": "{{bot.researcher}}",
                    "next": [
                      "{{bot.developer}}",
                      "{{bot.issue}}"
                    ],
                    "title": "Ship the widget",
                    "body": "Research how widgets are added, build one, then file the follow-up issue."
                  }
                }
              ]
            },
            {
              "steps": [
                {
                  "tool": "room_post",
                  "args": {
                    "kind": "report",
                    "title": "The widget is shipped",
                    "body": "Research, build and the follow-up issue are done."
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "key": "researcher",
        "template": "researcher",
        "repo": true,
        "triggers": [],
        "script": {
          "turns": [
            {
              "steps": [
                {
                  "capture": {
                    "key": "idempotency_key \"(wake:[^\"]+)\""
                  }
                },
                {
                  "tool": "fanout_start",
                  "args": {
                    "idempotency_key": "{{key}}",
                    "titles": [
                      "research widgets"
                    ],
                    "prompt": "Find out how a widget is added and write it down.",
                    "preset": "default",
                    "files": [
                      [
                        "notes.md"
                      ]
                    ]
                  }
                }
              ]
            },
            {
              "steps": [
                {
                  "capture": {
                    "parent": "(These tasks were started for)"
                  }
                },
                {
                  "tool": "handoff_send",
                  "args": {
                    "kind": "result",
                    "title": "Findings",
                    "body": "Widgets live in widgets/; add one file."
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "key": "developer",
        "template": "developer",
        "repo": true,
        "triggers": [],
        "script": {
          "turns": [
            {
              "steps": [
                {
                  "capture": {
                    "key": "idempotency_key \"(wake:[^\"]+)\""
                  }
                },
                {
                  "tool": "fanout_start",
                  "args": {
                    "idempotency_key": "{{key}}",
                    "titles": [
                      "add widget"
                    ],
                    "prompt": "Add the widget the findings describe.",
                    "preset": "default",
                    "files": [
                      [
                        "widgets/a.txt"
                      ]
                    ]
                  }
                }
              ]
            },
            {
              "steps": [
                {
                  "capture": {
                    "parent": "(These tasks were started for)"
                  }
                },
                {
                  "tool": "handoff_send",
                  "args": {
                    "kind": "result",
                    "title": "Widget built",
                    "body": "widgets/a.txt is added."
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "key": "issue",
        "template": "issue",
        "triggers": [],
        "script": {
          "turns": [
            {
              "steps": [
                {
                  "tool": "handoff_send",
                  "args": {
                    "kind": "result",
                    "title": "Follow-up filed",
                    "body": "Issue: document the widget."
                  }
                }
              ]
            }
          ]
        }
      }
    ]
  },
  "actions": [
    {
      "do": "post",
      "label": "ask",
      "post": {
        "title": "Ship a widget",
        "body": "Please get a widget shipped, with a follow-up issue.",
        "mentions": [
          "{{bot.lead}}"
        ]
      }
    },
    {
      "do": "waitFor",
      "label": "lead woken by the last result",
      "cond": {
        "wakes": {
          "bot": "lead",
          "reason": "handoff",
          "state": "done"
        }
      },
      "timeoutMs": 420000,
      "required": true
    },
    {
      "do": "waitFor",
      "label": "quiet",
      "cond": {
        "idle": true,
        "quietMs": 8000
      },
      "timeoutMs": 90000
    }
  ],
  "expect": {
    "requires": [
      "facts",
      "cards",
      "bots",
      "wakes",
      "handoffs",
      "ledger"
    ],
    "message": "ask",
    "lead": "lead",
    "relay": [
      "researcher",
      "developer",
      "issue"
    ],
    "workers": [
      "researcher",
      "developer"
    ]
  }
}
