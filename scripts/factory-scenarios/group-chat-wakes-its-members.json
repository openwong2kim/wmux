{
  "name": "group-chat-wakes-its-members",
  "layer": "regression",
  "runs": 1,
  "model": "stub",
  "description": "The owner makes a group chat of the coordinator and the developer (owner decision 2026-10-15: groups are the owner's, a coordinator is a bot like any other). An untagged message in the group's thread wakes every member once (one directed fact each, one shared run, the room flag on each wake, pinned to the group's thread), never a bot outside the group; each member answers in the group's thread; the card records both members. Then a message that picks the developer alone wakes only it.",
  "setup": {
    "bots": [
      {
        "key": "lead",
        "template": "coordinator",
        "triggers": [],
        "script": {
          "turns": [
            {
              "steps": [
                {
                  "tool": "room_post",
                  "args": {
                    "kind": "opinion",
                    "title": "On it",
                    "body": "I will pick who works on this."
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "key": "developer",
        "template": "developer",
        "triggers": [],
        "script": {
          "turns": [
            {
              "steps": [
                {
                  "tool": "room_post",
                  "args": {
                    "kind": "opinion",
                    "title": "Hi from developer",
                    "body": "developer here."
                  }
                }
              ]
            },
            {
              "steps": [
                {
                  "tool": "room_post",
                  "args": {
                    "kind": "opinion",
                    "title": "Hi from developer",
                    "body": "developer here."
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "key": "issue",
        "template": "issue",
        "triggers": [],
        "script": {
          "turns": [
            {
              "steps": [
                {
                  "tool": "room_post",
                  "args": {
                    "kind": "opinion",
                    "title": "Hi from issue",
                    "body": "issue here."
                  }
                }
              ]
            }
          ]
        }
      }
    ]
  },
  "actions": [
    {
      "do": "api",
      "label": "make the group",
      "fn": "factory.groups.create",
      "args": [
        {
          "workspaceId": "{{ws}}",
          "name": "Ship it",
          "memberIds": [
            "{{bot.lead}}",
            "{{bot.developer}}"
          ]
        }
      ],
      "record": true,
      "save": {
        "groupThread": "group.threadId"
      }
    },
    {
      "do": "post",
      "label": "hi",
      "post": {
        "threadId": "{{saved.groupThread}}",
        "title": "Hi team",
        "body": "Can someone look at the login bug?"
      }
    },
    {
      "do": "waitFor",
      "label": "both members answered",
      "cond": {
        "wakes": {
          "bot": "developer",
          "reason": "human",
          "state": "done"
        }
      },
      "timeoutMs": 60000,
      "required": true
    },
    {
      "do": "waitFor",
      "label": "lead answered",
      "cond": {
        "wakes": {
          "bot": "lead",
          "reason": "human",
          "state": "done"
        }
      },
      "timeoutMs": 60000,
      "required": true
    },
    {
      "do": "post",
      "label": "dev only",
      "post": {
        "threadId": "{{saved.groupThread}}",
        "title": "Developer only",
        "body": "Just the developer, please.",
        "mentions": [
          "{{bot.developer}}"
        ]
      }
    },
    {
      "do": "waitFor",
      "label": "quiet",
      "cond": {
        "idle": true,
        "quietMs": 5000
      },
      "timeoutMs": 30000
    }
  ],
  "expect": {
    "requires": [
      "facts",
      "cards",
      "bots",
      "wakes"
    ],
    "message": "hi",
    "picked": "dev only",
    "members": [
      "lead",
      "developer"
    ],
    "pickedBot": "developer",
    "silent": [
      "issue"
    ]
  }
}
