{
  "compilerOptions": {
    "target": "ESNext",
    "module": "commonjs",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "baseUrl": ".",
    "outDir": "dist",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@shared/*": [
        "src/shared/*"
      ],
      "@opencode-ai/sdk/v2/client": [
        "./node_modules/@opencode-ai/sdk/dist/v2/client"
      ]
    }
  },
  "include": [
    "src/**/*",
    "forge.env.d.ts"
  ]
}
