{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist/daemon",
    "rootDir": "src",
    "declaration": false,
    "sourceMap": false,
    "baseUrl": ".",
    "paths": {
      "@opencode-ai/sdk/v2/client": [
        "./node_modules/@opencode-ai/sdk/dist/v2/client"
      ]
    }
  },
  "include": [
    "src/daemon/**/*",
    "src/shared/**/*"
  ]
}
